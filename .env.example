# Copy this file to .env and fill in your own values. Never commit .env.
PLEX_URL=http://your-plex-ip:32400
PLEX_TOKEN=your_plex_token
TMDB_API_KEY=your_tmdb_api_key

# --- Optional settings (defaults shown; remove or leave blank to use the default) ---
# Comma-separated Plex library names to process
LIBRARIES=Movies,TV Shows
# Where artwork backups, the log, and the TMDb ID cache are stored
BASE_DIR=Posters
LOG_FILE=artwork_healer.log
CACHE_FILE=tmdb_cache.csv

# Safety: when true, only logs what would change. Set to false to apply changes.
DRY_RUN=true
# Upload artwork to Plex (only takes effect when DRY_RUN=false)
ENABLE_UPLOAD=true
# Re-upload even artwork that is working
FORCE_UPLOAD_ALL=false
ENABLE_LOG=true
# Select existing Plex clear logos / mobile backgrounds / title cards when unset or dead
SELECT_EXISTING_ART=true

# Seconds to wait between items
DELAY=1
